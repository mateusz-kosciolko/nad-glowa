---
import Layout from "@/layouts/Layout.astro";
import { describeLastRun } from "@/lib/cron-runs";
import { messageForCode } from "@/lib/form-errors";
import { createClient } from "@/lib/supabase";
import { cn } from "@/lib/utils";

const { user } = Astro.locals;

function formatAge(ageSeconds: number): string {
  return ageSeconds < 120 ? `${String(ageSeconds)} s` : `${String(Math.floor(ageSeconds / 60))} min`;
}

// Heartbeat of the minute job: without it, "no alerts" and "the clock stopped" look the same.
let cronLine: string;
let cronStale = false;
let lastRunFailed = false;
// Pause state of the user's alerts; null when it cannot be read, so the card shows no switch.
let alertsPaused: boolean | null = null;

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!supabase) {
  cronLine = "Cron status unavailable: Supabase is not configured.";
} else {
  // Independent reads, run in parallel; each card handles its own failure.
  const [cronResult, settingsResult] = await Promise.all([
    supabase
      .from("cron_runs")
      .select("started_at, status")
      .order("started_at", { ascending: false })
      .limit(1)
      .maybeSingle(),
    user ? supabase.from("alert_settings").select("paused").eq("user_id", user.id).maybeSingle() : null,
  ]);

  if (cronResult.error) {
    // The status card is informational; a failed read must not break the dashboard.
    cronLine = "Cron status unavailable.";
  } else {
    const lastRun = describeLastRun(cronResult.data?.started_at ?? null, new Date());
    if (lastRun.state === "never") {
      cronLine = "No cron runs yet";
    } else {
      cronLine = `Last cron run: ${formatAge(lastRun.ageSeconds)} ago`;
      cronStale = lastRun.state === "stale";
      lastRunFailed = cronResult.data?.status === "error";
    }
  }

  // Like the cron card: a failed read (or a missing row) must not break the dashboard.
  if (settingsResult && !settingsResult.error && settingsResult.data) {
    alertsPaused = settingsResult.data.paused;
  }
}

// Confirm only what the state just read agrees with: a reloaded or bookmarked URL must not contradict the card.
const alertsResult = Astro.url.searchParams.get("alerts");
const alertsConfirmation =
  alertsResult === "paused" && alertsPaused === true
    ? "Alerts paused."
    : alertsResult === "resumed" && alertsPaused === false
      ? "Alerts resumed."
      : null;
// The URL carries only error codes; never render the raw parameter.
const alertsError = messageForCode(Astro.url.searchParams.get("alerts_error"));
---

<Layout title="Dashboard">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl">
      <h1 class="mb-4 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
        Dashboard
      </h1>
      <p class="text-blue-100/80">
        Signed in as <span class="font-semibold text-white">{user?.email}</span>
      </p>
      <p class="mt-2 text-sm text-blue-100/50">This page is only for authenticated users.</p>
      <div
        class:list={cn(
          "mt-4 rounded-lg border px-3 py-2 text-sm",
          cronStale
            ? "border-amber-500/30 bg-amber-900/30 text-amber-200"
            : "border-white/10 bg-white/5 text-blue-100/80",
        )}
      >
        <p>
          {cronLine}
          {lastRunFailed && <span class="text-red-300"> (last run failed)</span>}
        </p>
        {cronStale && (
          <p class="mt-1 text-xs">
            No run for over 5 minutes — is <code>npm run cron:local</code> running?
          </p>
        )}
      </div>
      <div
        class:list={cn(
          "mt-4 rounded-lg border px-3 py-2 text-sm",
          alertsPaused === true
            ? "border-amber-500/30 bg-amber-900/30 text-amber-200"
            : "border-white/10 bg-white/5 text-blue-100/80",
        )}
      >
        {alertsPaused === null && <p>Alert status unavailable.</p>}
        {alertsPaused === false && (
          <form method="POST" action="/api/settings/pause" class="flex items-center justify-between gap-3">
            <p>Alerts: active</p>
            <input type="hidden" name="paused" value="true" />
            <button
              type="submit"
              class="rounded-lg border border-white/20 bg-white/10 px-3 py-1 text-xs whitespace-nowrap transition-colors hover:bg-white/20"
            >
              Pause alerts
            </button>
          </form>
        )}
        {alertsPaused === true && (
          <form method="POST" action="/api/settings/pause" class="flex items-center justify-between gap-3">
            <p>Alerts paused — you won't get notifications until you resume</p>
            <input type="hidden" name="paused" value="false" />
            <button
              type="submit"
              class="rounded-lg border border-amber-500/40 bg-amber-500/20 px-3 py-1 text-xs whitespace-nowrap transition-colors hover:bg-amber-500/30"
            >
              Resume alerts
            </button>
          </form>
        )}
        {alertsConfirmation && <p class="mt-1 text-xs text-green-300">{alertsConfirmation}</p>}
        {alertsError && <p class="mt-1 text-xs text-red-300">{alertsError}</p>}
      </div>
      <div class="mt-6 flex items-center justify-center gap-3">
        <a
          href="/settings"
          class="rounded-lg bg-purple-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-purple-500"
        >
          Alert settings
        </a>
        <a
          href="/alerts"
          class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
        >
          Alert history
        </a>
        <form method="POST" action="/api/auth/signout">
          <button
            type="submit"
            class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
          >
            Sign out
          </button>
        </form>
      </div>
    </div>
  </div>
</Layout>
