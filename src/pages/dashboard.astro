---
import Layout from "@/layouts/Layout.astro";
import { describeLastRun } from "@/lib/cron-runs";
import { createClient } from "@/lib/supabase";
import { cn } from "@/lib/utils";

const { user } = Astro.locals;

function formatAge(ageSeconds: number): string {
  return ageSeconds < 120 ? `${String(ageSeconds)} s` : `${String(Math.floor(ageSeconds / 60))} min`;
}

// Heartbeat of the minute job: without it, "no alerts" and "the clock stopped" look the same.
let cronLine: string;
let cronStale = false;
let lastRunFailed = false;

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (!supabase) {
  cronLine = "Cron status unavailable: Supabase is not configured.";
} else {
  const { data, error } = await supabase
    .from("cron_runs")
    .select("started_at, status")
    .order("started_at", { ascending: false })
    .limit(1)
    .maybeSingle();

  if (error) {
    // The status card is informational; a failed read must not break the dashboard.
    cronLine = "Cron status unavailable.";
  } else {
    const lastRun = describeLastRun(data?.started_at ?? null, new Date());
    if (lastRun.state === "never") {
      cronLine = "No cron runs yet";
    } else {
      cronLine = `Last cron run: ${formatAge(lastRun.ageSeconds)} ago`;
      cronStale = lastRun.state === "stale";
      lastRunFailed = data?.status === "error";
    }
  }
}
---

<Layout title="Dashboard">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl">
      <h1 class="mb-4 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
        Dashboard
      </h1>
      <p class="text-blue-100/80">
        Welcome, <span class="font-semibold text-white">{user?.email}</span>
      </p>
      <p class="mt-2 text-sm text-blue-100/50">This page is only for authenticated users.</p>
      <div
        class:list={cn(
          "mt-4 rounded-lg border px-3 py-2 text-sm",
          cronStale
            ? "border-amber-500/30 bg-amber-900/30 text-amber-200"
            : "border-white/10 bg-white/5 text-blue-100/80",
        )}
      >
        <p>
          {cronLine}
          {lastRunFailed && <span class="text-red-300"> (last run failed)</span>}
        </p>
        {cronStale && (
          <p class="mt-1 text-xs">
            No run for over 5 minutes — is <code>npm run cron:local</code> running?
          </p>
        )}
      </div>
      <div class="mt-6 flex items-center justify-center gap-3">
        <a
          href="/settings"
          class="rounded-lg bg-purple-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-purple-500"
        >
          Alert settings
        </a>
        <form method="POST" action="/api/auth/signout">
          <button
            type="submit"
            class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
          >
            Sign out
          </button>
        </form>
      </div>
    </div>
  </div>
</Layout>
