{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nad-glowa",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-05-08",
  "compatibility_flags": ["nodejs_compat"],
  // Preview URLs są publicznie dostępne; PRD traktuje przybliżoną lokalizację domową
  // jako dane wrażliwe, więc produkcja wystawia wyłącznie trasę workers.dev.
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  "observability": {
    "enabled": true,
  },
}
